# Copy values into your local environment; never commit real credentials.
# Example format only — replace with your local PostgreSQL settings.
DB_URL=jdbc:postgresql://localhost:5432/procureflow
DB_USERNAME=procureflow_app
DB_PASSWORD=REPLACE_WITH_LOCAL_SECRET

# Local development only; set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
APP_CORS_ORIGIN=http://localhost:4200
